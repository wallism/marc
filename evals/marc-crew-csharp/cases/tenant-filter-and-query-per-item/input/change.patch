+// New internal endpoint that wants every tenant's overdue invoices.
+[ApiController]
+[Route("internal/reports")]
+public sealed class InternalReportsController : ControllerBase
+{
+    [HttpGet("overdue")]
+    public async Task<IActionResult> Overdue([FromServices] OverdueInvoiceQuery query)
+        => Ok(await query.RunAsync(DateOnly.FromDateTime(DateTime.UtcNow)));
+}
