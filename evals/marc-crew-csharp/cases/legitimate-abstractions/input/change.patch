diff --git a/src/Shop.Catalog/Dimensions.cs b/src/Shop.Catalog/Dimensions.cs
new file mode 100644
--- /dev/null
+++ b/src/Shop.Catalog/Dimensions.cs
@@ -0,0 +1,6 @@
+namespace Shop.Catalog;
+
+public readonly record struct Dimensions(decimal WidthMm, decimal HeightMm, decimal DepthMm)
+{
+    public bool IsOversized => WidthMm > 1200m || HeightMm > 1200m || DepthMm > 1200m;
+}
diff --git a/src/Shop.Catalog/VolumeMath.cs b/src/Shop.Catalog/VolumeMath.cs
new file mode 100644
--- /dev/null
+++ b/src/Shop.Catalog/VolumeMath.cs
@@ -0,0 +1,7 @@
+namespace Shop.Catalog;
+
+public static class VolumeMath
+{
+    public static decimal LitresOf(Dimensions dimensions)
+        => dimensions.WidthMm * dimensions.HeightMm * dimensions.DepthMm / 1_000_000m;
+}
